FROM python:3.12-slim

# Only Flask needed — no rasterio/GDAL required for demo mode
RUN pip install --no-cache-dir "Flask==3.1.3" "flask-cors==6.0.5"

WORKDIR /app

# Copy the demo API + embedded pre-computed results
# api/demo_data/ is NOT excluded by .dockerignore (only results/ rules apply there)
COPY api/ api/

# Independent-reference fixture data (pre-computed, read-only)
COPY results/independent_references/ results/independent_references/

# Railway injects $PORT; fall back to 8765 for local runs
ENV PORT=8765
EXPOSE $PORT

CMD ["sh", "-c", "python api/demo_api.py --host 0.0.0.0 --port ${PORT}"]
